        "@semantic-release/git": "^11.0.1",
        "conventional-changelog-conventionalcommits": "10.2.1",
        "cz-conventional-changelog": "^3.3.0",
        "husky": "^9.1.7",
        "laravel-mix": "^6.0.49",
        "lint-staged": "^17.3.0",
        "postcss": "^8.4.38",
        "semantic-release": "^25.0.9",
        "vue-loader": "^17.4.2",
        "webpack": "~5.105.4",
        "webpack-cli": "~5.1.4"
    },
    "dependencies": {
        "@ai-sdk/vue": "~4.0.22",
